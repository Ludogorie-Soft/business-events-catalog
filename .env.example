# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/business_events_catalog?schema=public"

# Auth.js / NextAuth (v5 prefers AUTH_* names; NEXTAUTH_* still works as fallback)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Optional aliases (keep in sync with AUTH_* if both are set):
# NEXTAUTH_SECRET="same-as-AUTH_SECRET"
# NEXTAUTH_URL="http://localhost:3000"

# Brevo (email)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Бизнес Събития България"

# Cron security
CRON_SECRET="generate-with-openssl-rand-base64-32"
